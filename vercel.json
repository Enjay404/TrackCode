{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    {
      "source": "/((?!api/|assets/|.*\\.(?:jpg|jpeg|png|gif|webp|svg|ico|xml|txt|json|js|css|woff|woff2|map|webmanifest)$).*)",
      "destination": "/index.html"
    }
  ]
}
